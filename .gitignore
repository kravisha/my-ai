.venv/
__pycache__/
*.pyc
.env
permissions.json
audit_log.jsonl
privacy_preferences.json
users.json
sessions.json
user_data/
.cli_session
.gui_session
.pytest_cache/
financial_intelligence.db
financial_intelligence.db-wal
financial_intelligence.db-shm

# The Gateway's own store: sessions and the Super User's conversation transcript.
# Separate from the FI database by design (see gateway/store.py), and no more
# versionable - it is live local state, and its session rows are credentials.
gateway.db
gateway.db-wal
gateway.db-shm
# Simulation run output: one directory per run, each holding its own database
# and log. Reproducible from the scenario plus the manifest's recorded seed and
# code version, so the runs themselves are not worth versioning.
simulation/runs/
# Backup sets (backend/continuity.py): copies of the live stores above, and
# exactly as sensitive - gateway.db session rows and sessions.json are
# credentials in the backup too.
backups/
# The secondary-destination encryption key (backend/continuity.py's
# ensure_backup_key): Tier-0 recovery material. A copy belongs OFF this
# machine; no copy ever belongs in the repository.
backup.key
# The model-spend ledger (app/model_budget.py): live local state, one row per
# UTC day, shared by every process that calls the model.
model_spend.db
# The model performance registry (app/model_performance.py, TQ-54): measured
# outcomes per model per task category, machine-written after every task. It is
# deliberately not committed - that is the whole reason it is a database rather
# than a section of docs/model_registry.yaml, which holds the hand-authored half.
model_performance.db
model_performance.db-wal
model_performance.db-shm
