# Variable NAMES only. Never a real value in this file.

# The application's model routing, as of 2026-09-16: local first, Kimi remote
# second, an explicit failure third. Nothing falls back to Anthropic - see
# app/model_routing.py, which refuses at construction to contain that vendor.

# Required for the remote tier. Without it the router has no remote provider and
# every request fails explicitly, which is the intended behaviour rather than a
# reason to add a fallback.
KIMI_API_KEY=your-key-here

# Optional. Both default to the values a real probe verified on 2026-09-16
# (Deployments/probe-kimi-api.ps1, trace in _probe-kimi.log) and neither needs
# setting unless the provider changes them.
#   KIMI_BASE_URL       default https://api.kimi.com/coding/v1
#   KIMI_MODEL_REMOTE   default k3-256k
#   KIMI_TIMEOUT_SECONDS  default 120
# KIMI_BASE_URL=
# KIMI_MODEL_REMOTE=
# KIMI_TIMEOUT_SECONDS=

# NOT read by the application any more. It is kept because the Claude
# development sessions on these machines use it, and because deleting a
# credential other tooling depends on was explicitly ruled out. No application
# model call can reach this vendor: app/model_routing.assert_no_anthropic
# refuses to build a router containing it.
ANTHROPIC_API_KEY=your-key-here
